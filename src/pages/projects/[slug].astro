---
import ProjectDetail from '@/views/ProjectDetail.astro';
import { getProjects } from '@/lib/content';

export async function getStaticPaths() {
  const items = await getProjects('ar');
  return items.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<ProjectDetail lang="ar" project={project} />