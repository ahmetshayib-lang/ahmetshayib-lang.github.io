---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Cover from '@/components/Cover.astro';
import StatusTag from '@/components/StatusTag.astro';
import { getProjects, type Localized } from '@/lib/content';
import { t, localizePath, num, list } from '@/i18n/utils';
import { publicationTypes, languageNames, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  pub: Localized<'publications'>;
}
const { lang, pub } = Astro.props;
const d = pub.data;
const { Content } = await render(pub.entry);
const project = d.project ? (await getProjects(lang)).find((p) => p.slug === d.project) : undefined;
const langs = d.languages.map((l) => languageNames[l][lang]);
---
<BaseLayout lang={lang} path={`/publications/${pub.slug}/`} title={d.title} description={d.description ?? d.summary}
  ogImage={d.cover?.src} ogType="book">
  <div class="wrap">
    <section class="detail-hero">
      <div class="reveal">
        <nav class="crumbs" aria-label="breadcrumb">
          <a href={localizePath(lang, '/publications/')}>{t(lang, 'nav.publications')}</a><span aria-hidden="true">/</span><span>{publicationTypes[d.type][lang]}</span>
        </nav>
        <h1>{d.title}</h1>
        {d.altTitle && <p class="alt" lang={lang === 'ar' ? 'en' : 'ar'}>{d.altTitle}</p>}
        {d.subtitle && <p class="lead">{d.subtitle}</p>}
      </div>
      <div class="reveal reveal-2" style="max-width:24rem;width:100%;justify-self:center">
        <Cover lang={lang} title={d.title} altTitle={d.altTitle} kicker={publicationTypes[d.type][lang]} style={d.coverStyle} image={d.cover} imageAlt={d.coverAlt} shape="book" eager decorative={false} />
      </div>
    </section>

    <section class="case">
      <dl class="facts">
        <div><dt>{t(lang, 'detail.type')}</dt><dd>{publicationTypes[d.type][lang]}</dd></div>
        <div><dt>{t(lang, 'detail.status')}</dt><dd><StatusTag lang={lang} status={d.status} /></dd></div>
        {project && <div><dt>{t(lang, 'detail.project')}</dt><dd><a href={localizePath(lang, `/projects/${project.slug}/`)}>{project.data.title}</a></dd></div>}
        {langs.length > 0 && <div><dt>{t(lang, 'detail.languages')}</dt><dd>{list(lang, langs)}</dd></div>}
        {d.year && <div><dt>{t(lang, 'detail.year')}</dt><dd>{d.year}</dd></div>}
        {d.publisher && <div><dt>{t(lang, 'detail.publisher')}</dt><dd>{d.publisher}</dd></div>}
        {d.pages && <div><dt>{t(lang, 'detail.pages')}</dt><dd>{num(lang, d.pages)}</dd></div>}
        {d.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
        {
          d.links.length > 0 && (
            <div>
              <dt>{t(lang, 'detail.links')}</dt>
              <dd>{d.links.map((l) => <a class="link" href={l.url} rel="noopener" target="_blank" style="display:block">{l.label}</a>)}</dd>
            </div>
          )
        }
      </dl>
      <article class="prose">
        <Content />
      </article>
    </section>

    {
      d.gallery.length > 0 && (
        <section class="section" aria-labelledby="gallery-title">
          <div class="section-head"><h2 id="gallery-title">{t(lang, 'detail.gallery')}</h2></div>
          <div class="gallery">
            {d.gallery.map((g) => (
              <figure>
                <Image src={g.image} alt={g.alt} widths={[400, 700]} sizes="(max-width: 620px) 100vw, 33vw" />
                {g.caption && <figcaption>{g.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <a class="next-link" href={localizePath(lang, '/publications/')}>
      <span class="t">{t(lang, 'detail.back.publications')}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</BaseLayout>
