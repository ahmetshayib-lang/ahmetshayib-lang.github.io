---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BookCover from '@/components/BookCover.astro';
import StatusTag from '@/components/StatusTag.astro';
import PublicationCard from '@/components/PublicationCard.astro';
import { getProjects, getPublications, type Localized } from '@/lib/content';
import { t, localizePath, num, list } from '@/i18n/utils';
import { publicationTypeSingular, projectCategories, languageNames, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  pub: Localized<'publications'>;
}
const { lang, pub } = Astro.props;
const d = pub.data;
const { Content } = await render(pub.entry);
const project = d.project ? (await getProjects(lang)).find((p) => p.slug === d.project) : undefined;
const siblings = project ? (await getPublications(lang)).filter((p) => p.data.project === project.slug && p.slug !== pub.slug) : [];
const langs = d.languages.map((l) => languageNames[l][lang]);
const typeLabel = publicationTypeSingular[d.type][lang];
---
<BaseLayout lang={lang} path={`/publications/${pub.slug}/`} title={d.title} description={d.description ?? d.summary}
  ogImage={d.cover?.src} ogType="book">
  <div class="wrap">
    <section class="detail-hero">
      <div class="reveal">
        <nav class="crumbs" aria-label="breadcrumb">
          <a href={localizePath(lang, '/publications/')}>{t(lang, 'nav.publications')}</a><span aria-hidden="true">/</span><span>{typeLabel}</span>
        </nav>
        {
          project && (
            <p class="parent-line">
              <span class="label">{projectCategories[project.data.category][lang]}</span>
              <a href={localizePath(lang, `/projects/${project.slug}/`)}>
                {lang === 'ar' ? `من «${project.data.title}»` : `From ${project.data.title}`} <span class="arrow" aria-hidden="true">→</span>
              </a>
            </p>
          )
        }
        <h1>{d.title}</h1>
        {d.altTitle && <p class="alt" lang={lang === 'ar' ? 'en' : 'ar'}>{d.altTitle}</p>}
        {d.subtitle ? <p class="lead">{d.subtitle}</p> : <p class="lead">{d.summary}</p>}
      </div>
      <div class="reveal reveal-2 detail-book">
        <BookCover lang={lang} title={d.title} image={d.cover} alt={d.coverAlt} size="hero" eager decorative={false} />
      </div>
    </section>

    <section class="case">
      <dl class="facts">
        <div><dt>{t(lang, 'detail.type')}</dt><dd>{typeLabel}</dd></div>
        <div><dt>{t(lang, 'detail.status')}</dt><dd><StatusTag lang={lang} status={d.status} /></dd></div>
        {d.audience && <div><dt>{t(lang, 'detail.audience')}</dt><dd>{d.audience}</dd></div>}
        {project && <div><dt>{t(lang, 'detail.project')}</dt><dd><a href={localizePath(lang, `/projects/${project.slug}/`)}>{project.data.title}</a></dd></div>}
        {langs.length > 0 && <div><dt>{t(lang, 'detail.languages')}</dt><dd>{list(lang, langs)}</dd></div>}
        {d.year && <div><dt>{t(lang, 'detail.year')}</dt><dd>{d.year}</dd></div>}
        {d.publisher && <div><dt>{t(lang, 'detail.publisher')}</dt><dd>{d.publisher}</dd></div>}
        {d.pages && <div><dt>{t(lang, 'detail.pages')}</dt><dd>{num(lang, d.pages)}</dd></div>}
        {d.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
        {
          d.links.length > 0 && (
            <div>
              <dt>{t(lang, 'detail.links')}</dt>
              <dd>{d.links.map((l) => <a class="link" href={l.url} rel="noopener" target="_blank" style="display:block">{l.label}</a>)}</dd>
            </div>
          )
        }
      </dl>
      <article class="prose">
        <Content />
      </article>
    </section>

    {
      d.gallery.length > 0 && (
        <section class="section" aria-labelledby="gallery-title">
          <div class="section-head"><h2 id="gallery-title">{t(lang, 'detail.gallery')}</h2></div>
          <div class="gallery">
            {d.gallery.map((g) => (
              <figure>
                <Image src={g.image} alt={g.alt} widths={[400, 700]} sizes="(max-width: 620px) 100vw, 33vw" />
                {g.caption && <figcaption>{g.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      project && siblings.length > 0 && (
        <section class="section" aria-labelledby="sib-title">
          <div class="section-head">
            <h2 id="sib-title">{lang === 'ar' ? `أيضًا من «${project.data.title}»` : `Also from ${project.data.title}`}</h2>
          </div>
          <div class="pub-list">{siblings.map((s) => <PublicationCard lang={lang} pub={s} />)}</div>
        </section>
      )
    }

    <a class="next-link" href={localizePath(lang, '/publications/')}>
      <span class="t">{t(lang, 'detail.back.publications')}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</BaseLayout>
