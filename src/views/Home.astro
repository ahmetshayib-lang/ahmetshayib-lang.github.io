---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Cover from '@/components/Cover.astro';
import BookCover from '@/components/BookCover.astro';
import PublicationCard from '@/components/PublicationCard.astro';
import { getProjects, getPublications, getPage, getProjectTitles } from '@/lib/content';
import { t, localizePath, num } from '@/i18n/utils';
import { projectCategories, publicationTypeSingular, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const projects = await getProjects(lang);
const pubs = await getPublications(lang);
const titles = await getProjectTitles(lang);
const about = await getPage(lang, 'about');

/* Index: each project followed by its own publications, then independent books. */
type Row = { href: string; title: string; alt?: string; cat: string; child: boolean };
const rows: Row[] = [];
for (const p of projects) {
  rows.push({ href: `/projects/${p.slug}/`, title: p.data.title, alt: p.data.altTitle, cat: projectCategories[p.data.category][lang], child: false });
  for (const b of pubs.filter((b) => b.data.project === p.slug)) {
    rows.push({ href: `/publications/${b.slug}/`, title: b.data.title, alt: b.data.altTitle, cat: publicationTypeSingular[b.data.type][lang], child: true });
  }
}
for (const b of pubs.filter((b) => !b.data.project || !titles.has(b.data.project))) {
  rows.push({ href: `/publications/${b.slug}/`, title: b.data.title, alt: b.data.altTitle, cat: publicationTypeSingular[b.data.type][lang], child: false });
}

const wwc = projects.find((p) => p.slug === 'what-we-carry');
const wwcBooks = wwc ? pubs.filter((b) => b.data.project === wwc.slug) : [];
const others = projects.filter((p) => p.slug !== 'what-we-carry' && p.data.featured);
const otherLang = lang === 'ar' ? 'en' : 'ar';
---
<BaseLayout lang={lang} path="/">
  <div class="wrap">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title" class="reveal">
        <span>{t(lang, 'home.hero.1')}</span><span>{t(lang, 'home.hero.2')}</span><span>{t(lang, 'home.hero.3')}</span>
      </h1>
      <div class="hero-aside reveal reveal-2">
        <p>{t(lang, 'home.hero.lead')}</p>
        <a class="btn btn-primary" href={localizePath(lang, '/about/')}>
          {t(lang, 'home.cta.about')} <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section aria-labelledby="index-title" class="reveal reveal-3">
      <h2 id="index-title" class="sr-only">{t(lang, 'home.index')}</h2>
      <ol class="toc">
        {
          rows.map((r, i) => (
            <li class:list={[r.child && 'toc-child']}>
              <a href={localizePath(lang, r.href)}>
                <span class="num">{num(lang, i + 1)}</span>
                <span class="t">
                  {r.title}
                  {r.alt && <small lang={otherLang}>{r.alt}</small>}
                </span>
                <span class="cat">{r.cat}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  {
    wwc && (
      <section class="feature feature-wwc" aria-labelledby="wwc-title">
        <div class="wrap feature-inner">
          <div class="feature-text">
            <p class="label">{projectCategories[wwc.data.category][lang]}</p>
            <h2 id="wwc-title">{wwc.data.title}{wwc.data.altTitle && <small lang={otherLang}>{wwc.data.altTitle}</small>}</h2>
            <p class="feature-lead">{wwc.data.summary}</p>
            {wwc.data.campaign && (
              <p class="feature-rel">
                <span class="label">{t(lang, 'campaign.link')}</span>{' '}
                <a class="link" href={localizePath(lang, `/projects/${wwc.slug}/#${wwc.data.campaign.id}`)}>{wwc.data.campaign.title}</a>
              </p>
            )}
            <a class="btn btn-light" href={localizePath(lang, `/projects/${wwc.slug}/`)}>
              {t(lang, 'home.cta.initiative')} <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <div class="feature-books">
            <p class="label">{t(lang, 'home.initiativePubs')}</p>
            <div class="feature-shelf">
              {wwcBooks.map((b) => (
                <a href={localizePath(lang, `/publications/${b.slug}/`)} class="feature-book">
                  <BookCover lang={lang} title={b.data.title} image={b.data.cover} alt={b.data.coverAlt} />
                  <span class="fb-type">{publicationTypeSingular[b.data.type][lang]}{b.data.audience && ` · ${b.data.audience}`}</span>
                  <span class="fb-title">{b.data.title}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="section wrap" aria-labelledby="pubs-title">
    <div class="section-head">
      <h2 id="pubs-title">{t(lang, 'home.publications')}</h2>
      <a class="link label" href={localizePath(lang, '/publications/')}>{t(lang, 'home.cta.publications')}</a>
    </div>
    <div class="pub-list">
      {pubs.map((pub) => <PublicationCard lang={lang} pub={pub} parentTitle={pub.data.project ? titles.get(pub.data.project) : undefined} />)}
    </div>
  </section>

  {
    others.map((p) => {
      const books = pubs.filter((b) => b.data.project === p.slug);
      return (
        <section class="feature feature-light" aria-labelledby={`f-${p.slug}`}>
          <div class="wrap feature-inner">
            <a class="feature-visual" href={localizePath(lang, `/projects/${p.slug}/`)} tabindex="-1" aria-hidden="true">
              <Cover lang={lang} title={p.data.title} kicker={projectCategories[p.data.category][lang]} style={p.data.coverStyle} image={p.data.cover} imageAlt={p.data.coverAlt} shape="wide" />
            </a>
            <div class="feature-text">
              <p class="label">{projectCategories[p.data.category][lang]}</p>
              <h2 id={`f-${p.slug}`}>{p.data.title}{p.data.altTitle && <small lang={otherLang}>{p.data.altTitle}</small>}</h2>
              <p class="feature-lead">{p.data.summary}</p>
              {books.length > 0 && (
                <p class="feature-rel">
                  {t(lang, 'detail.projectPublications')}:{' '}
                  {books.map((b, i) => (
                    <>{i > 0 && (lang === 'ar' ? '، ' : ', ')}<a class="link" href={localizePath(lang, `/publications/${b.slug}/`)}>{b.data.title}</a></>
                  ))}
                </p>
              )}
              <a class="btn btn-secondary" href={localizePath(lang, `/projects/${p.slug}/`)}>
                {t(lang, 'cta.view')} <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </section>
      );
    })
  }

  {
    about?.data.vision && (
      <section class="section wrap vision" aria-labelledby="vision-title">
        <p class="label" id="vision-title">{t(lang, 'home.vision')}</p>
        <blockquote class="vision-quote">{about.data.vision}</blockquote>
        <a class="link label" href={localizePath(lang, '/about/')}>{t(lang, 'home.cta.about')}</a>
      </section>
    )
  }
</BaseLayout>
