---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PublicationCard from '@/components/PublicationCard.astro';
import { getPublications, getProjectTitles } from '@/lib/content';
import { t } from '@/i18n/utils';
import { publicationTypes, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const pubs = await getPublications(lang);
const titles = await getProjectTitles(lang);
/* Groups follow the order in publicationTypes; empty groups are not shown. */
const groups = (Object.keys(publicationTypes) as (keyof typeof publicationTypes)[])
  .map((type) => ({ type, items: pubs.filter((p) => p.data.type === type) }))
  .filter((g) => g.items.length > 0);
---
<BaseLayout lang={lang} path="/publications/" title={t(lang, 'publications.title')} description={t(lang, 'publications.lead')}>
  <div class="wrap">
    <header class="page-head">
      <h1 class="page-title reveal">{t(lang, 'publications.title')}</h1>
      <p class="lead reveal reveal-2">{t(lang, 'publications.lead')}</p>
    </header>
    {
      groups.map((g, gi) => (
        <section class="pub-group" aria-labelledby={`g-${g.type}`}>
          <div class="section-head">
            <h2 id={`g-${g.type}`}>{publicationTypes[g.type][lang]}</h2>
          </div>
          <div class="pub-list">
            {g.items.map((pub) => (
              <PublicationCard lang={lang} pub={pub} parentTitle={pub.data.project ? titles.get(pub.data.project) : undefined} eager={gi === 0} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
