---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t, localizePath } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<BaseLayout lang={lang} path="/404/" altPath="/" title={t(lang, '404.title')} noindex>
  <div class="wrap">
    <header class="page-head" style="padding-block:var(--s7)">
      <p class="num" style="color:var(--rose);font-size:var(--fs-h1)">{lang === 'ar' ? '٤٠٤' : '404'}</p>
      <h1 class="page-title">{t(lang, '404.title')}</h1>
      <p class="lead">{t(lang, '404.lead')}</p>
      <p><a class="btn btn-primary" href={localizePath(lang, '/')}>{t(lang, '404.home')} <span class="arrow" aria-hidden="true">→</span></a></p>
    </header>
  </div>
</BaseLayout>
