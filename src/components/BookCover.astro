---
/**
 * A book cover on a "shelf": the original cover image, never cropped or redrawn.
 * When no official cover has been supplied yet, a neutral plate says so plainly —
 * it is never styled to pass as a real cover.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  image?: ImageMetadata;
  alt?: string;
  size?: 'card' | 'hero';
  eager?: boolean;
  /** Set when the title is printed right next to the cover. */
  decorative?: boolean;
}
const { lang, title, image, alt = '', size = 'card', eager = false, decorative = true } = Astro.props;
const sizes = size === 'hero' ? '(max-width: 860px) 80vw, 26rem' : '(max-width: 620px) 70vw, 16rem';
---
<div class:list={['shelf', size === 'hero' && 'shelf-hero']}>
  {
    image ? (
      <Image src={image} alt={decorative ? '' : alt} widths={[320, 480, 720, 960]} sizes={sizes}
        loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} class="shelf-img" />
    ) : (
      <div class="shelf-plate" role={decorative ? undefined : 'img'} aria-label={decorative ? undefined : title} aria-hidden={decorative ? 'true' : undefined}>
        <span class="plate-title">{title}</span>
        <span class="plate-note">{t(lang, 'cover.pending')}</span>
      </div>
    )
  }
</div>
